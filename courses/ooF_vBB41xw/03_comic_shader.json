      "default": "#F4A33A"
     },
     {
      "name": "Dot Resolution",
      "type": "NodeSocketFloat",
      "default": 60
     },
     {
      "name": "Outline Thickness",
      "type": "NodeSocketFloat",
      "default": 0.5,
      "min": 0,
      "max": 1
     },
     {
      "name": "Hatching Color",
      "type": "NodeSocketColor",
      "default": "#1B1030"
     },
     {
      "name": "Hatching Opacity",
      "type": "NodeSocketFloat",
      "default": 1.0,
      "min": 0,
      "max": 1
     },
     {
      "name": "Highlight Color",
      "type": "NodeSocketColor",
      "default": "#FFFFFF"
     },
     {
      "name": "Highlight Opacity",
      "type": "NodeSocketFloat",
      "default": 1.0,
      "min": 0,
      "max": 1
     },
     {
      "name": "Color",
      "in_out": "OUTPUT",
      "type": "NodeSocketColor"
     }
    ]
   },
   "note": "the node group (selected nodes, Ctrl+G), named, with the controls exposed on its input: the colour, dot resolution, outline thickness, hatching and highlight colours and their opacities",
   "video_time": "9:31"
  },
  {
   "action": "edit_nodes",
   "args": {
    "tree": "group",
    "group": "Comic Shader",
    "nodes": [
     {
      "name": "Window",
      "type": "ShaderNodeTexCoord"
     },
     {
      "name": "Dots",
      "type": "ShaderNodeTexVoronoi",
      "inputs": {
       "Randomness": 0.0
      }
     },
     {
      "name": "DotMask",
      "type": "ShaderNodeMath",
      "props": {
       "operation": "GREATER_THAN"
      }
     }
    ],
    "links": [
     {
      "from": "Window",
      "output": "Window",
      "to": "Dots",
      "input": "Vector"
     },
     {
      "from": "Group Input",
      "output": "Dot Resolution",
      "to": "Dots",
      "input": "Scale"
     },
     {
      "from": "Dots",
      "output": "Distance",
      "to": "DotMask",
      "input": 0
     }
    ]
   },
   "note": "the dots: a voronoi with randomness 0 (a grid) on window coordinates (projected from the view, like a printed comic), greater than a threshold: moving the threshold scales the dots",
   "video_time": "5:05"
  },
  {
   "action": "edit_nodes",
   "args": {
    "tree": "group",
    "group": "Comic Shader",
    "nodes": [
     {
      "name": "LightCatcher",
      "type": "ShaderNodeBsdfDiffuse"
     },
     {
      "name": "LightToRGB",
      "type": "ShaderNodeShaderToRGB"
     },
     {
      "name": "Flip",
      "type": "ShaderNodeMapRange",
      "inputs": {
       "From Max": 0.55,
       "To Min": 0.75,
       "To Max": 0.02
      }
     }
    ],
    "links": [
     {
      "from": "LightCatcher",
      "output": "BSDF",
      "to": "LightToRGB",
      "input": "Shader"
     },
     {
      "from": "LightToRGB",
      "output": "Color",
      "to": "Flip",
      "input": "Value"
     }
    ]
   },
   "note": "light drives the threshold: a diffuse BSDF as the light catcher, Shader to RGB (Eevee only), a map range flipped (to 1..0: the dark gets the big dots; to min = the biggest dots, from max = how light-sensitive the grid is)",
   "video_time": "6:10"
  },
  {
   "action": "edit_nodes",
   "args": {
    "tree": "group",
    "group": "Comic Shader",
    "nodes": [
