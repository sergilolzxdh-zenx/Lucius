{
 "title": "Comic Shader",
 "summary": "A comic-book shader as a reusable node group: a principled BSDF through Shader to RGB (Eevee) multiplied by a dot mask -- a grid voronoi (randomness 0) on window coordinates compared (greater than) with a threshold that comes from the light (a diffuse BSDF through Shader to RGB and a flipped map range), so shadows fill with ever bigger hatching dots; a fresnel edge (thickness remapped to its IOR, multiplied) added to the threshold for a dotted outline; glossy highlights clamped by a constant ramp and added in the highlight colour. Grouped (Ctrl+G) with its controls exposed, used on Suzanne and on a torus with other colours; a circling sun shows the dots follow the light.",
 "objects": [
  {
   "name": "Mono",
   "description": "Suzanne with the comic shader"
  },
  {
   "name": "Dona",
   "description": "a torus with the same group"
  }
 ],
 "expected_result": "An orange Suzanne and a blue torus in a flat comic style: halftone dots growing into the shadows, dotted dark outlines, white highlights; the dots move as the sun circles.",
 "steps": [
