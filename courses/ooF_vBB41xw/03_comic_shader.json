       "To Max": 1.45
      }
     },
     {
      "name": "Edge",
      "type": "ShaderNodeFresnel"
     },
     {
      "name": "EdgeBoost",
      "type": "ShaderNodeMath",
      "props": {
       "operation": "MULTIPLY"
      },
      "inputs": {
       "1": 5.0
      }
     },
     {
      "name": "Threshold",
      "type": "ShaderNodeMath",
      "props": {
       "operation": "ADD"
      }
     }
    ],
    "links": [
     {
      "from": "Group Input",
      "output": "Outline Thickness",
      "to": "Thickness",
      "input": "Value"
     },
     {
      "from": "Thickness",
      "output": "Result",
      "to": "Edge",
      "input": "IOR"
     },
     {
      "from": "Edge",
      "output": "Fac",
      "to": "EdgeBoost",
      "input": 0
     },
     {
      "from": "Flip",
      "output": "Result",
      "to": "Threshold",
      "input": 0
     },
     {
      "from": "EdgeBoost",
      "output": 0,
      "to": "Threshold",
      "input": 1
     },
     {
      "from": "Threshold",
      "output": 0,
      "to": "DotMask",
      "input": 1
     }
    ]
   },
   "note": "the outline: a fresnel mask (its IOR from a map range of the thickness slider: 1 = no line), multiplied up so the edge beats the dots, added to the threshold (a wavy, dotted edge)",
   "video_time": "7:35"
  },
  {
